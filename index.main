<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>VC Back-To-School Kick Off | Shoe Sign-Up</title>
<style>
  :root{
    --chalk-green:#2F4538;
    --chalk-green-dark:#22332A;
    --marigold:#E8A33D;
    --marigold-dark:#C9861F;
    --paper:#F7F3E8;
    --paper-line:#DCD3B8;
    --denim:#3B5773;
    --ink:#26302B;
    --red-pencil:#C0553B;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    font-family:'Georgia', 'Times New Roman', serif;
    background-color:var(--chalk-green);
    background-image:
      linear-gradient(rgba(255,255,255,0.5), rgba(255,255,255,0.5)),
      url('data:image/jpeg;base64,');
    background-size:cover;
    background-position:center;
    background-attachment:fixed;
    color:var(--ink);
    min-height:100vh;
    padding:32px 16px 64px;
  }
  .sheet{
    max-width:640px;
    margin:0 auto;
    background:var(--paper);
    border-radius:6px;
    box-shadow:0 20px 50px rgba(0,0,0,0.35);
    overflow:hidden;
    position:relative;
  }
  .spiral{
    position:absolute;
    left:0; top:0; bottom:0;
    width:26px;
    background:repeating-linear-gradient(180deg, transparent 0 10px, #cfc6a6 10px 12px, transparent 12px 26px);
  }
  .header{
    background:var(--denim);
    color:var(--paper);
    padding:28px 32px 28px 52px;
    position:relative;
  }
  .eyebrow{
    font-family:'Trebuchet MS', sans-serif;
    text-transform:uppercase;
    letter-spacing:0.18em;
    font-size:12px;
    color:var(--marigold);
    font-weight:700;
  }
  h1{
    margin:6px 0 4px;
    font-size:32px;
    line-height:1.1;
  }
  .subline{
    font-family:'Trebuchet MS', sans-serif;
    font-size:14px;
    color:#D9E3EA;
  }
  .ruler{
    display:flex;
    align-items:flex-end;
    gap:2px;
    margin-top:16px;
    height:20px;
  }
  .ruler span{
    display:block;
    width:6px;
    background:var(--marigold);
    opacity:0.85;
  }
  form{
    padding:28px 32px 32px 52px;
  }
  .event-card{
    background:#fff;
    border:1px dashed var(--denim);
    border-radius:4px;
    padding:14px 16px;
    margin-bottom:24px;
    font-family:'Trebuchet MS', sans-serif;
    font-size:14px;
    color:var(--ink);
  }
  .event-card b{color:var(--denim);}
  .event-card .edit-hint{
    display:block;
    margin-top:6px;
    font-size:11px;
    color:#9a917a;
  }
  fieldset{
    border:none;
    padding:0;
    margin:0 0 22px;
  }
  legend{
    font-family:'Trebuchet MS', sans-serif;
    font-weight:700;
    font-size:13px;
    text-transform:uppercase;
    letter-spacing:0.08em;
    color:var(--chalk-green);
    border-bottom:2px solid var(--marigold);
    padding-bottom:4px;
    margin-bottom:14px;
    width:100%;
  }
  label{
    display:block;
    font-family:'Trebuchet MS', sans-serif;
    font-size:13px;
    color:var(--ink);
    margin-bottom:4px;
    margin-top:12px;
    font-weight:600;
  }
  input[type=text], input[type=email], input[type=tel], select{
    width:100%;
    padding:9px 10px;
    border:1px solid var(--paper-line);
    border-bottom:2px solid var(--denim);
    border-radius:3px;
    font-family:'Trebuchet MS', sans-serif;
    font-size:14px;
    background:#fff;
    color:var(--ink);
  }
  input:focus, select:focus{
    outline:2px solid var(--marigold);
    outline-offset:1px;
  }
  .child-card{
    background:#fff;
    border-radius:5px;
    padding:16px 16px 6px;
    margin-bottom:14px;
    border-left:4px solid var(--marigold);
    box-shadow:0 2px 6px rgba(0,0,0,0.06);
  }
  .child-card-head{
    display:flex;
    justify-content:space-between;
    align-items:center;
  }
  .child-card-head b{
    font-family:'Trebuchet MS', sans-serif;
    color:var(--chalk-green);
    font-size:13px;
    text-transform:uppercase;
    letter-spacing:0.06em;
  }
  .remove-child{
    background:none;
    border:none;
    color:var(--red-pencil);
    font-family:'Trebuchet MS', sans-serif;
    font-size:12px;
    cursor:pointer;
    text-decoration:underline;
  }
  .two-col{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:0 12px;
  }
  .add-child{
    background:var(--paper);
    border:2px dashed var(--denim);
    color:var(--denim);
    font-family:'Trebuchet MS', sans-serif;
    font-weight:700;
    font-size:13px;
    padding:10px;
    width:100%;
    border-radius:4px;
    cursor:pointer;
    margin-top:2px;
  }
  .add-child:hover{background:#eee5c8;}
  .submit-btn{
    width:100%;
    background:var(--marigold);
    color:var(--chalk-green-dark);
    border:none;
    padding:14px;
    font-family:'Trebuchet MS', sans-serif;
    font-weight:800;
    font-size:16px;
    border-radius:4px;
    cursor:pointer;
    margin-top:8px;
    letter-spacing:0.02em;
  }
  .submit-btn:hover{background:var(--marigold-dark);}
  .submit-btn:disabled{opacity:0.6;cursor:not-allowed;}
  .note{
    font-family:'Trebuchet MS', sans-serif;
    font-size:11px;
    color:#8b8467;
    margin-top:8px;
    text-align:center;
  }
  .confirm{
    display:none;
    padding:32px;
    text-align:center;
  }
  .confirm.show{display:block;}
  form.hide{display:none;}
  .confirm .stamp{
    display:inline-block;
    border:3px solid var(--red-pencil);
    color:var(--red-pencil);
    font-family:'Trebuchet MS', sans-serif;
    font-weight:800;
    text-transform:uppercase;
    padding:8px 18px;
    border-radius:6px;
    transform:rotate(-4deg);
    letter-spacing:0.08em;
    margin-bottom:16px;
  }
  .confirm h2{
    font-family:'Trebuchet MS', sans-serif;
    color:var(--chalk-green);
    margin:0 0 8px;
  }
  .confirm p{
    font-family:'Trebuchet MS', sans-serif;
    color:var(--ink);
    font-size:14px;
  }
  .err{
    color:var(--red-pencil);
    font-family:'Trebuchet MS', sans-serif;
    font-size:12px;
    margin-top:6px;
    display:none;
  }
  .err.show{display:block;}
</style>
</head>
<body>
<div class="sheet">
  <div class="spiral"></div>
  <div class="header">
    <div class="eyebrow">Valley Crossroads Presents</div>
    <h1>VC Back-To-School Kick Off</h1>
    <div class="subline" id="eventLine">Shoe sign-up for school-age kids &middot; details below</div>
    <div class="ruler">
      <span style="height:20px"></span><span style="height:8px"></span><span style="height:8px"></span><span style="height:14px"></span><span style="height:8px"></span><span style="height:8px"></span><span style="height:20px"></span><span style="height:8px"></span><span style="height:8px"></span><span style="height:14px"></span><span style="height:8px"></span><span style="height:8px"></span><span style="height:20px"></span>
    </div>
  </div>

  <form id="signupForm">
    <div class="event-card">
      <div><b>Event:</b> VC Back-To-School Kick Off</div>
      <div><b>Date:</b> <span id="fDate">Sunday, 8/30/2026</span> &nbsp; <b>Time:</b> <span id="fTime">4:00 PM</span></div>
      <div><b>Location:</b> <span id="fLoc">25620 The Old Rd Suite P, Stevenson Ranch, CA 91381</span></div>
    </div>

    <fieldset>
      <legend>Parent / Guardian</legend>
      <label for="pName">Full name</label>
      <input type="text" id="pName" required>
      <div class="two-col">
        <div>
          <label for="pEmail">Email</label>
          <input type="email" id="pEmail" required>
        </div>
        <div>
          <label for="pPhone">Phone</label>
          <input type="tel" id="pPhone" placeholder="(optional)">
        </div>
      </div>
    </fieldset>

    <fieldset>
      <legend>Kids Getting Shoes</legend>
      <div id="childrenWrap"></div>
      <button type="button" class="add-child" id="addChildBtn">+ Add Another Child</button>
    </fieldset>

    <div class="err" id="formErr">Please fill in all required fields for each child.</div>
    <button type="submit" class="submit-btn" id="submitBtn">Sign Up</button>
    <div class="note">Your info is saved for event organizers only.</div>
  </form>

  <div class="confirm" id="confirmBox">
    <div class="stamp">Registered!</div>
    <h2>You're on the list.</h2>
    <p id="confirmDetail"></p>
    <p>See you at the kick off.</p>
  </div>
</div>

<script>
const GRADES = ["Pre-K","Kindergarten","1st","2nd","3rd","4th","5th","6th","7th","8th","9th","10th","11th","12th"];
let childCount = 0;

function addChild(){
  childCount++;
  const id = childCount;
  const wrap = document.getElementById('childrenWrap');
  const card = document.createElement('div');
  card.className = 'child-card';
  card.dataset.id = id;
  card.innerHTML = `
    <div class="child-card-head">
      <b>Child ${id}</b>
      <button type="button" class="remove-child" data-id="${id}">Remove</button>
    </div>
    <label>Child's name</label>
    <input type="text" class="cName" required>
    <div class="two-col">
      <div>
        <label>Grade</label>
        <select class="cGrade" required>
          <option value="">Select</option>
          ${GRADES.map(g=>`<option value="${g}">${g}</option>`).join('')}
        </select>
      </div>
      <div>
        <label>Shoe size (US)</label>
        <input type="text" class="cShoe" placeholder="e.g. 2Y, 7" required>
      </div>
    </div>
  `;
  wrap.appendChild(card);
  card.querySelector('.remove-child').addEventListener('click', (e)=>{
    card.remove();
    renumber();
  });
}

function renumber(){
  const cards = document.querySelectorAll('.child-card');
  cards.forEach((c, i)=>{
    c.querySelector('b').textContent = `Child ${i+1}`;
  });
}

document.getElementById('addChildBtn').addEventListener('click', addChild);
addChild();

document.getElementById('signupForm').addEventListener('submit', async (e)=>{
  e.preventDefault();
  const errBox = document.getElementById('formErr');
  const cards = document.querySelectorAll('.child-card');
  if(cards.length === 0){
    errBox.textContent = "Please add at least one child.";
    errBox.classList.add('show');
    return;
  }
  const children = [];
  let valid = true;
  cards.forEach(c=>{
    const name = c.querySelector('.cName').value.trim();
    const grade = c.querySelector('.cGrade').value;
    const shoe = c.querySelector('.cShoe').value.trim();
    if(!name || !grade || !shoe) valid = false;
    children.push({name, grade, shoe});
  });
  if(!valid){
    errBox.classList.add('show');
    return;
  }
  errBox.classList.remove('show');

  const submitBtn = document.getElementById('submitBtn');
  submitBtn.disabled = true;
  submitBtn.textContent = "Saving...";

  const record = {
    parentName: document.getElementById('pName').value.trim(),
    parentEmail: document.getElementById('pEmail').value.trim(),
    parentPhone: document.getElementById('pPhone').value.trim(),
    children,
    submittedAt: new Date().toISOString()
  };

  try{
    const key = `signup:${Date.now()}-${Math.random().toString(36).slice(2,8)}`;
    await window.storage.set(key, JSON.stringify(record), true);
  }catch(err){
    console.error('Storage error', err);
  }

  document.getElementById('confirmDetail').textContent =
    `${record.parentName}, we've got ${children.length} kid${children.length>1?'s':''} down for shoes.`;
  document.getElementById('signupForm').classList.add('hide');
  document.getElementById('confirmBox').classList.add('show');
});
</script>
</body>
</html>
